# Local Docker Compose only; copy to .env and replace the placeholders.
INTERNAL_API_TOKEN=replace-with-random-32-byte-token
DEMO_USERNAME=replace-with-demo-username
DEMO_PASSWORD=replace-with-strong-password
DATABASE_PATH=/data/tasks.db
# Azure resource names are supplied by you, no default subscription is assumed.
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=
AZURE_ACR_NAME=
AZURE_CONTAINERAPPS_ENV=
AZURE_FRONTEND_APP=
AZURE_BACKEND_APP=
AZURE_DATABASE_APP=
# Configuration: GitHub Actions VARIABLES (never commit live keys)
# AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_SUBSCRIPTION_ID
# GHCR_USER, BROKER_IMAGE_DIGEST (ghcr.io/owner/image@sha256:...)
# AI_PROVIDER=gemini or groq, GEMINI_MODEL, GROQ_MODEL
# APPROVAL_GATE_ENABLED (leave unset until environment reviewers configured)
# GitHub Actions SECRETS:
# GHCR_READ_TOKEN, GEMINI_API_KEY, GROQ_API_KEY
# INTERNAL_API_TOKEN, DEMO_USERNAME, DEMO_PASSWORD
